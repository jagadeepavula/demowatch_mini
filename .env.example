# Copy to .env for local runs (never commit .env)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Supabase -> Connect -> Session pooler (the IPv4 one). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Your GitHub Pages address, no trailing slash (use * only while testing)
ALLOWED_ORIGINS=*
